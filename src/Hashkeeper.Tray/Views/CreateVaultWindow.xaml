<Window x:Class="Hashkeeper.Tray.Views.CreateVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hashkeeper.Tray.ViewModels"
        xmlns:controls="clr-namespace:Hashkeeper.Tray.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CreateVaultViewModel}"
        Title="Hashkeeper – Create vault"
        Icon="/Assets/hashkeeper.ico"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource VaultWindowStyle}">

    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource HeadingStyle}" Text="Create your vault" />
        <TextBlock Style="{StaticResource HintStyle}">
            Choose a Master Password. It encrypts everything stored in Hashkeeper
            and cannot be recovered if you forget it.
        </TextBlock>

        <Label Content="_Master Password" Target="{Binding ElementName=PasswordInput}" />
        <controls:RevealablePasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />

        <Label Content="_Confirm Master Password" Target="{Binding ElementName=ConfirmationInput}" Margin="0,12,0,0" />
        <controls:RevealablePasswordBox x:Name="ConfirmationInput" PasswordChanged="OnConfirmationChanged" />

        <TextBlock Style="{StaticResource ValidationStyle}" Text="{Binding ValidationMessage}" />
        <TextBlock Style="{StaticResource ErrorStyle}" Text="{Binding ErrorMessage}" />
        <ProgressBar Style="{StaticResource BusyStyle}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Create vault" Command="{Binding CreateCommand}" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
