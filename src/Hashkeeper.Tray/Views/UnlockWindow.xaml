<Window x:Class="Hashkeeper.Tray.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Hashkeeper.Tray.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UnlockViewModel}"
        Title="Hashkeeper – Unlock"
        Icon="/Assets/hashkeeper.ico"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource VaultWindowStyle}">

    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource HeadingStyle}" Text="Unlock your vault" />

        <Label Content="_Master Password" Target="{Binding ElementName=PasswordInput}" />
        <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />

        <TextBlock Style="{StaticResource ErrorStyle}" Text="{Binding ErrorMessage}" />
        <ProgressBar Style="{StaticResource BusyStyle}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Unlock" Command="{Binding UnlockCommand}" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
