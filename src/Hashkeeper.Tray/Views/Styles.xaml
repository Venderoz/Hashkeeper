<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colours taken from the app icon. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1A2232" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#243047" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8EEF5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA8BC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4FE3F0" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0E1A24" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" />

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <Style x:Key="VaultWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="HeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Hints and messages collapse when they have no text. -->
    <Style x:Key="HintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Padding" Value="0,0,0,4" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Padding" Value="6,5" />
    </Style>

    <Style x:Key="BusyStyle" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Height" Value="3" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Visibility" Value="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
