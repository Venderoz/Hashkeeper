<UserControl x:Class="Hashkeeper.Tray.Views.Controls.RevealablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="True"
             IsTabStop="False">

    <UserControl.Resources>
        <!-- The frame turns cyan while either input has keyboard focus. -->
        <Style x:Key="FrameStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource MutedTextBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Inputs without their own frame; the Border above draws it. -->
        <Style x:Key="BarePasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BareTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eye button: "View" glyph while hidden, "Hide" glyph while the password is shown. -->
        <Style x:Key="RevealToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <TextBlock x:Name="Glyph"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE890;"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xED1A;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource FrameStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="HiddenInput"
                         Style="{StaticResource BarePasswordBoxStyle}"
                         PasswordChanged="OnHiddenInputChanged" />
            <TextBox x:Name="VisibleInput"
                     Style="{StaticResource BareTextBoxStyle}"
                     Visibility="Collapsed"
                     TextChanged="OnVisibleInputChanged" />

            <ToggleButton x:Name="RevealToggle"
                          Grid.Column="1"
                          Style="{StaticResource RevealToggleStyle}"
                          ToolTip="Show password"
                          AutomationProperties.Name="Show password"
                          Checked="OnRevealChanged"
                          Unchecked="OnRevealChanged" />
        </Grid>
    </Border>
</UserControl>
